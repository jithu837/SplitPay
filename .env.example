# ==========================================================
# Root-level reference for all environment variables used
# across SplitPay. Copy the relevant values into:
#   backend/src/main/resources/application.properties  (from application.properties.example)
#   frontend/.env                                        (from frontend/.env.example)
# Never commit the real files — only the .example templates.
# ==========================================================

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/splitpay

# ---- JWT ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_BYTES
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Razorpay (TEST MODE keys only — see https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=CHANGE_ME

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Frontend ----
VITE_API_BASE_URL=/api
